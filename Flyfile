# Flyfile —— 部署 chisel 隧道服务端（https://github.com/jpillora/chisel）
#
# 为什么不能照抄仓库里的 example/Flyfile：
#   它写的是 ENTRYPOINT ["/app/bin", "server", ...]，而官方镜像自 1.12 起是 CI 用 ko 构建的
#   （见 .github/ko-base.Dockerfile + .github/goreleaser.yml 的 kos 段：scratch 基础镜像 + CA 根证书，
#   仓库里根本没有 Dockerfile，只有 ko 会把静态二进制塞进镜像）。
#   ko 的二进制路径不是 /app/bin —— 这就是上一轮部署日志里
#   "failed to spawn command: /app/bin ... No such file or directory (os error 2)" 的原因。
#
# 所以这一版不去猜镜像内部结构：直接从源码编译，二进制路径由这里写死。
# 顺带把版本钉死，避免哪天 latest 又换了布局。
#
# 认证：Fly 应用的「Secrets / 秘密」里加 AUTH=用户名:密码（chisel 1.12 起没冒号的 auth 会直接启动失败）
# 端口：容器内明文 8080，TLS 由 Fly 边缘终止（见 fly.toml 的 [http_service]）

# ---------- 构建阶段 ----------
FROM golang:alpine AS build

ARG CHISEL_VERSION=v1.12.0

ENV GOTOOLCHAIN=auto \
    CGO_ENABLED=0

# go install 走 proxy.golang.org，不需要 git；仓库根包就是 main，所以能直接 install
RUN mkdir -p /out && GOBIN=/out go install github.com/jpillora/chisel@${CHISEL_VERSION}

# ---------- 运行阶段 ----------
FROM alpine:3.21

# 留着 CA 根证书：以后若改成 --tls-domain 让 chisel 自己签 Let's Encrypt 会用到
RUN apk add --no-cache ca-certificates

COPY --from=build /out/chisel /usr/local/bin/chisel

EXPOSE 8080

# -v：把启动横幅（版本、监听地址、服务器 fingerprint）打进 Fly 日志，排查用
# --reverse：允许客户端 R: 反向端口转发；--socks5：允许客户端用 socks 把它当出口
ENTRYPOINT ["/usr/local/bin/chisel", "server", "--port", "8080", "--reverse", "--socks5", "-v"]
